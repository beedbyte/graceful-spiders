GracefulBoundary.Q24Terminal.generic_source (k z p : Nat) (c : List Nat) (h : GracefulBoundary.P20Q24.State k z c)
  (hk : k = 2 * p + 3) :
  GracefulBoundary.GenericPathCertificate (p + 12)
      (GracefulBoundary.coreLabels (2 * (k + 24)) (GracefulBoundary.Q24Terminal.extend z c)) ∧
    (GracefulBoundary.coreLabels (2 * (k + 24)) (GracefulBoundary.Q24Terminal.extend z c))[z + 1]? =
        some (2 * (k + 24)) ∧
      (GracefulBoundary.coreLabels (2 * (k + 24)) (GracefulBoundary.Q24Terminal.extend z c))[z + 2]? = some 0
GracefulBoundary.Q24Terminal.terminal_actual (t n m : Nat) (ht : 1 ≤ t) (hn : 2 ≤ n) (a : Fin n) :
  GracefulBoundary.P20Q24.DepthZero n m (23 + 24 * t) (20 + 22 * t) a ∧
    GracefulBoundary.P20Q24.DepthZero n m (23 + 24 * t) (21 + 22 * t) a
GracefulBoundary.Q24Terminal.flip_certificate (s : Nat) :
  GracefulBoundary.FiniteAlpha.Certificate (22 + 12 * s) (42 + 22 * s) (43 + 22 * s)
    (GracefulBoundary.coreLabels (94 + 48 * s) (GracefulBoundary.Q24Terminal.flipWord s))
