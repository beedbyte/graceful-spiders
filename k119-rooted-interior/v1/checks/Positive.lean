theorem exact_fixed {W F : Type} (H : IndexedGraph W F) (root : W) (g : W → Nat)
    (Q d : Nat) (hg : ConventionalGraceful H Q g) (hroot : g root=0) (hd : 1≤d ∧ d≤118) :
    (∃ f : GraftVertices (Fin 239) W (⟨119,by decide⟩ : Fin 239) → Nat,
      ConventionalGraceful (graftGraph (pathGraph 238) H (⟨119,by decide⟩ : Fin 239) root) (238+Q) f ∧
      f (graftEmbed (⟨119,by decide⟩ : Fin 239) root ⟨119-d,by omega⟩)=0) ∧
    (∃ f : GraftVertices (Fin 239) W (⟨119,by decide⟩ : Fin 239) → Nat,
      ConventionalGraceful (graftGraph (pathGraph 238) H (⟨119,by decide⟩ : Fin 239) root) (238+Q) f ∧
      f (graftEmbed (⟨119,by decide⟩ : Fin 239) root ⟨119+d,by omega⟩)=0) :=
  K119Through118.expanded H root g Q d hg hroot hd

theorem exact_family34 {W F : Type} (H : IndexedGraph W F) (root : W) (g : W → Nat)
    (Q r d : Nat) (hr : 1≤r) (hg : ConventionalGraceful H Q g) (hroot : g root=0)
    (hd : d=(30*4^r-1)-4 ∨ d=(30*4^r-1)-3) :
    TerminalNormalized.ActualAt H root Q (2*(30*4^r-1)) (30*4^r-1) ((30*4^r-1)-d) ∧
    TerminalNormalized.ActualAt H root Q (2*(30*4^r-1)) (30*4^r-1) ((30*4^r-1)+d) :=
  TerminalSeed34.rooted_exact H root g Q r (30*4^r-1) d hr rfl hg hroot hd
theorem exact_family12 {W F : Type} (H : IndexedGraph W F) (root : W) (g : W → Nat)
    (Q r d : Nat) (hr : 1≤r) (hg : ConventionalGraceful H Q g) (hroot : g root=0)
    (hd : d=(30*4^r-1)-2 ∨ d=(30*4^r-1)-1) :
